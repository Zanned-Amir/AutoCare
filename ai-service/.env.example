# Copy to .env to run outside Docker (uvicorn app.main:app --reload)
KAFKA_BOOTSTRAP=localhost:9094
INTERNAL_TOKEN=dev-internal-token

# mock = no model needed. openai = any OpenAI-compatible API.
LLM_PROVIDER=mock
# Ollama on your PC:
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
