# AutoCare TN - local settings. Copy to .env (never commit .env).
# Read by docker-compose.dev.yml and by Spring Boot (spring.config.import), so one file serves both.
# Every value shown is the default; you only need the lines you change.
# In production every "secret" line is required: application-prod.yaml has no defaults for them.

# ---- Spring profile: dev (default) | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autocare
POSTGRES_USER=autocare
POSTGRES_PASSWORD=autocare

# ---- Redis (cache, rate limits, live notifications)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=autocare

# ---- Object storage (MinIO in dev, S3 in prod)
S3_ENDPOINT=http://localhost:9000
# Host put in signed file links; must be reachable by the browser. Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=autocare
S3_SECRET_KEY=autocare2026
S3_BUCKET=autocare
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Mail (Mailpit in dev: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=AutoCare TN <no-reply@autocare.tn>
MAIL_SUPPORT=support@autocare.tn
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Security (secret)
# HS256 key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# Comma separated. Add every origin you open the web app on (e.g. a second dev server on :4201).
CORS_ALLOWED_ORIGINS=http://localhost:4200
# true behind HTTPS (forced in prod)
COOKIE_SECURE=false

# ---- Web app origin, used in e-mail links and after OAuth sign-in
WEB_BASE_URL=http://localhost:4200

# ---- Dev seed admin (dev profile only)
DEV_ADMIN_EMAIL=admin@autocare.tn
DEV_ADMIN_PASSWORD=Admin@123456

# ---- OAuth (a provider is on when its client id is set). Callback to register at the provider:
#      {OAUTH_REDIRECT_BASE_URL}/auth/oauth/{google|facebook|github}/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:4200/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Android/iOS client ids accepted for mobile ID tokens, comma separated
GOOGLE_EXTRA_CLIENT_IDS=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Services id (web) and bundle id (iOS), comma separated
APPLE_CLIENT_IDS=

# ---- SMS: log (printed in the API log) | twilio
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Telegram bot (empty token = off). mode: polling (dev) | webhook (prod, needs a public URL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# ---- Angular dev server: where /api is forwarded (frontend/proxy.conf.mjs)
API_PROXY_TARGET=http://localhost:8080
